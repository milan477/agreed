# Point the UI at the backend API (default below)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase (project rylmfwaocacwebgfmtas)
NEXT_PUBLIC_SUPABASE_URL=https://rylmfwaocacwebgfmtas.supabase.co
