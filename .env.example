# ── agreed environment ───────────────────────────────────────────────────────
# Everything runs offline with deterministic heuristic agents if these are unset.

# LLM backend: "openai" | "wandb" | "heuristic" (default: auto-detect, else heuristic)
AGREED_LLM_BACKEND=
NEGOTIATOR_MODEL=gpt-4o-mini

# OpenAI (used for negotiators + Realtime voice onboarding)
OPENAI_API_KEY=

# W&B / Weave (observability + W&B Inference + self-improvement MCP)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=agreed
WEAVE_PROJECT=agreed
# W&B Inference (OpenAI-compatible endpoint)
WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1

# Sandboxing
E2B_API_KEY=

# Research
EXA_API_KEY=

# Memory
REDIS_URL=redis://localhost:6379/0
MEM0_API_KEY=

# Persistence — Supabase Postgres in production, SQLite locally
SUPABASE_URL=https://rylmfwaocacwebgfmtas.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Postgres URI — Supabase → Settings → Database → Connection string (paste password)
# Direct: postgresql://postgres:[PASSWORD]@db.rylmfwaocacwebgfmtas.supabase.co:5432/postgres
DATABASE_URL=
# Required for chat history (Supabase Postgres URI). Chat persistence does not use SQLite.
# Optional override for SQLite path when DATABASE_URL is unset (non-chat records only)
AGREED_DB_PATH=

# Deployment (Google Cloud Run)
# Comma-separated origins allowed by the API (set to your frontend URL in prod)
CORS_ORIGINS=
# Public URL of the backend (for Twilio voice webhooks), e.g. https://agreed-api-xxx.run.app
PUBLIC_BASE_URL=

# Twilio — SMS + voice follow-ups (falls back to macOS iMessage/FaceTime locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
